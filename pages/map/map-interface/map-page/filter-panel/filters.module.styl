.admonishments
  position: relative

.admonishment
  margin: 0px 0px
  font-size: 12px
  position: relative
  width: 100%
  padding: 0px 0px
  display: block

  .button-contents
    display: flex
    align-items: center
    justify-content: space-between
    gap: 0.5em
    padding: 0 4px 0 0.5em
    width: 100%

    button
      min-width: 16px
      min-height: 16px

    .spacer
      flex-grow: 1

  .spacer
    flex-grow: 1

  &:global(.bp6-button.bp6-small)
    border-bottom-left-radius: 0
    border-bottom-right-radius: 0
    padding-left: 0
    padding-right: 0
    margin-bottom: 0

.filter-tag
  display: flex;
  align-items: center;
  gap: 0.5em;
  margin: 5px;

  .spacer
    flex-grow: 1;


// One compact row: the filters as tags, behind a filter icon
.filter-summary
  display: flex
  align-items: center
  gap: 0.4em

.filter-icon
  flex-shrink: 0
  color: var(--pz-secondary-color, var(--secondary-color))

.filter-tags
  display: flex
  flex-wrap: wrap
  align-items: center
  gap: 0.3em
  flex-grow: 1
  min-width: 0

.filters
  padding: 4px 6px

.filter-container
  margin-top: 4px
  border-top: 1px solid var(--panel-rule-color)
